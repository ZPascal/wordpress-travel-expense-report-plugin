<?xml version="1.0"?>
<ruleset name="WordPress Plugin Coding Standards">
    <description>Coding standards for Travel Expense Report plugin.</description>

    <!-- Exclude internal and vendor files -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <!-- Supported file extensions -->
    <arg name="extensions" value="php"/>

    <!-- Show sniff codes and progress -->
    <arg value="sp"/>
    <arg name="colors"/>

    <!-- Path to check -->
    <file>.</file>

    <!-- Include WordPress Coding Standards -->
    <!-- Note: You may need to install WPCS locally for this to work in your editor -->
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra"/>

    <!-- Plugin-specific settings -->
    <config name="text_domain" value="travel-expense-report"/>

    <!-- These helpers return already-escaped output -->
    <rule ref="WordPress.Security.EscapeOutput">
        <properties>
            <property name="customEscapingFunctions" type="array">
                <element value="ter_get_translated_html"/>
                <element value="ter_get_translated_attr"/>
                <element value="ter_get_translated_html_content"/>
                <element value="wp_create_nonce"/>
            </property>
        </properties>
    </rule>

    <!-- Renaming the main plugin file would deactivate existing installs -->
    <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
        <exclude-pattern>travel_expense_report.php</exclude-pattern>
    </rule>

    <!-- Check for PHP cross-version compatibility -->
    <config name="testVersion" value="8.1-"/>
    <rule ref="PHPCompatibility"/>

    <!-- Verify that no forbidden functions are used -->
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="exec" value="null"/>
                <element key="system" value="null"/>
                <element key="passthru" value="null"/>
                <element key="shell_exec" value="null"/>
            </property>
        </properties>
    </rule>
    <rule ref="Squiz.PHP.Eval"/>
</ruleset>
