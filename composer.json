{
    "name": "dpsg/travel-expense-report",
    "description": "WordPress plugin for travel expense report submissions with file uploads and email delivery",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Pascal Zimmermann",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "tecnickcom/tcpdf": "^6.4",
        "setasign/fpdi": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.4",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "TravelExpenseReport\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "test:verbose": "phpunit -c phpunit.xml.dist --verbose",
        "test:coverage": "phpunit -c phpunit.xml.dist --coverage-html=coverage"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
